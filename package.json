{
  "name": "@qualflare/cypress",
  "version": "0.7.0",
  "description": "Native Cypress reporter for the Qualflare test-management platform.",
  "keywords": [
    "qualflare",
    "cypress",
    "test-reporter",
    "e2e",
    "test-results",
    "flaky-tests",
    "test-reporting"
  ],
  "homepage": "https://qualflare.com",
  "bugs": {
    "url": "https://github.com/Qualflare/qualflare-cypress/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Qualflare/qualflare-cypress.git"
  },
  "license": "Apache-2.0",
  "author": "Qualflare",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "import": "./dist/plugin/index.js",
      "require": "./dist/plugin/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "cypress": ">=12.0.0"
  },
  "dependencies": {
    "ci-info": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^18.19.50",
    "cypress": "^15.0.0",
    "eslint": "^9.9.1",
    "execa": "^9.3.1",
    "prettier": "^3.3.3",
    "tsup": "^8.2.4",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.5.0",
    "undici": "^6.19.8",
    "vitest": "^2.0.5"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run test/unit",
    "test:integration": "vitest run test/integration --pool=forks --testTimeout=120000",
    "test:all": "npm run test && npm run test:integration",
    "prepublishOnly": "npm run build",
    "test:e2e": "cypress run --config-file e2e/cypress.config.ts --browser electron",
    "verify:e2e": "node e2e/verify-report.mjs",
    "e2e": "npm run test:e2e && npm run verify:e2e"
  }
}
